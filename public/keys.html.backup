<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expert - Key Management System</title>
    <style>
        /* Embedded CSS to avoid MIME type issues */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 2rem;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 2rem;
            text-align: center;
        }

        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            font-weight: 300;
        }

        .header p {
            opacity: 0.9;
            font-size: 1.1rem;
        }

        .content {
            padding: 2rem;
        }

        .section {
            margin-bottom: 3rem;
        }

        .section h2 {
            color: #2d3748;
            margin-bottom: 1.5rem;
            font-size: 1.5rem;
            font-weight: 600;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 0.5rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #4a5568;
        }

        input[type="text"],
        input[type="password"],
        input[type="datetime-local"],
        textarea {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.2s ease;
            background-color: white;
        }

        input[type="text"]:focus,
        input[type="password"]:focus,
        input[type="datetime-local"]:focus,
        textarea:focus {
            outline: none;
            border-color: #4299e1;
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.1);
        }

        .preset-buttons {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.5rem;
            flex-wrap: wrap;
        }

        .preset-btn {
            padding: 0.25rem 0.75rem;
            border: 1px solid #cbd5e0;
            border-radius: 20px;
            background: white;
            color: #4a5568;
            cursor: pointer;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .preset-btn:hover {
            background: #f7fafc;
            border-color: #a0aec0;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }

        .btn-primary {
            background: linear-gradient(135deg, #4299e1 0%, #3182ce 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(66, 153, 225, 0.3);
        }

        .btn-secondary {
            background: #f7fafc;
            color: #4a5568;
            border: 2px solid #e2e8f0;
        }

        .btn-secondary:hover {
            background: #edf2f7;
            border-color: #cbd5e0;
        }

        .btn-danger {
            background: #fc8181;
            color: white;
        }

        .btn-danger:hover {
            background: #f56565;
        }

        .btn-small {
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
        }

        .validation-section {
            background: #f8fafc;
            padding: 1.5rem;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
        }

        .validation-result {
            margin-top: 1rem;
            padding: 1rem;
            border-radius: 8px;
            font-weight: 600;
        }

        .validation-result.valid {
            background: #c6f6d5;
            color: #22543d;
            border: 1px solid #9ae6b4;
        }

        .validation-result.invalid {
            background: #fed7d7;
            color: #742a2a;
            border: 1px solid #fc8181;
        }

        .alert {
            padding: 1rem;
            border-radius: 8px;
            margin: 1rem 0;
            font-weight: 600;
        }

        .alert-success {
            background: #c6f6d5;
            color: #22543d;
            border: 1px solid #9ae6b4;
        }

        .alert-error {
            background: #fed7d7;
            color: #742a2a;
            border: 1px solid #fc8181;
        }

        .storage-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin: 1rem 0;
        }

        .keys-list {
            max-height: 400px;
            overflow-y: auto;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
        }

        .key-item {
            padding: 1rem;
            border-bottom: 1px solid #f7fafc;
            background: white;
        }

        .key-item:last-child {
            border-bottom: none;
        }

        .key-item:hover {
            background: #f8fafc;
        }

        .key-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.5rem;
        }

        .key-nickname {
            font-weight: 600;
            color: #2d3748;
            font-size: 1.1rem;
        }

        .key-actions {
            display: flex;
            gap: 0.5rem;
            flex-shrink: 0;
        }

        .key-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.875rem;
            color: #4a5568;
        }

        .key-display {
            background: #f7fafc;
            padding: 0.75rem;
            border-radius: 6px;
            font-family: 'Courier New', monospace;
            font-size: 0.875rem;
            word-break: break-all;
            border: 1px solid #e2e8f0;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        .management-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .status-indicator {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-valid {
            background: #c6f6d5;
            color: #22543d;
        }

        .status-expired {
            background: #fed7d7;
            color: #742a2a;
        }

        .status-expiring {
            background: #fef5e7;
            color: #c05621;
        }

        .copy-btn, .delete-btn {
            font-size: 0.875rem;
        }

        /* Mobile responsiveness */
        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }

            .header {
                padding: 1.5rem;
            }

            .header h1 {
                font-size: 2rem;
            }

            .content {
                padding: 1.5rem;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
            }

            .management-actions {
                grid-template-columns: 1fr;
            }

            .storage-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .key-header {
                flex-direction: column;
                gap: 0.5rem;
            }

            .key-actions {
                align-self: flex-start;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔑 Key Management System</h1>
            <p>Create and manage encrypted keys with expiration dates</p>
        </div>

        <div class="content">
            <!-- Access Control Section -->
            <div class="section" id="access-control-section">
                <h2>🔒 Access Control</h2>
                <div class="validation-section">
                    <div class="form-group">
                        <label for="access-password">Enter Access Password</label>
                        <input type="password" id="access-password" placeholder="Enter password to access key generator">
                    </div>
                    <button type="button" class="btn btn-primary" onclick="verifyAccess()">🔓 Unlock Key Generator</button>
                    <div id="access-result"></div>
                </div>
            </div>

            <!-- Key Creation Section -->
            <div class="section" id="key-creation-section" style="display: none;">
                <h2>🆕 Create New Key</h2>
                <form id="create-key-form">
                    <div class="form-group">
                        <label for="nickname">Nickname (optional)</label>
                        <input type="text" id="nickname" placeholder="Enter a nickname for this key">
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="custom-string">String to Encode</label>
                            <input type="text" id="custom-string" placeholder="Enter the string to encode" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="password">Password</label>
                            <input type="password" id="password" placeholder="Enter password (min 4 chars)" value="ExperT" required>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="expiration-date">Expiration Date</label>
                        <input type="datetime-local" id="expiration-date" required>
                        <div class="preset-buttons">
                            <button type="button" class="preset-btn" onclick="setPresetDate(7)">+7 days</button>
                            <button type="button" class="preset-btn" onclick="setPresetDate(30)">+30 days</button>
                            <button type="button" class="preset-btn" onclick="setPresetDate(90)">+90 days</button>
                            <button type="button" class="preset-btn" onclick="setUnlimitedDate()">Unlimited</button>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary">🔑 Create Key</button>
                </form>
            </div>

            <!-- Key Validation Section -->
            <div class="section">
                <h2>🔍 Validate Key</h2>
                <div class="validation-section">
                    <div class="form-group">
                        <label for="key-input">Enter Key to Validate</label>
                        <textarea id="key-input" rows="3" placeholder="Paste your key here..."></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label for="validation-password">Password</label>
                        <input type="password" id="validation-password" placeholder="Enter password to decode" value="ExperT">
                    </div>
                    
                    <button type="button" class="btn btn-secondary" onclick="validateKey()">🔍 Validate Key</button>
                    
                    <div id="validation-result"></div>
                </div>
            </div>

            <!-- Storage Management Section -->
            <div class="section">
                <h2>💾 Storage Management</h2>
                
                <div id="storage-stats" class="storage-stats">
                    <!-- Storage stats will be populated here -->
                </div>
                
                <div class="management-actions">
                    <button type="button" class="btn btn-secondary btn-small" onclick="keyManager.cleanupExpiredKeys()">🧹 Cleanup Expired</button>
                    <button type="button" class="btn btn-secondary btn-small" onclick="keyManager.exportKeys()">📤 Export Keys</button>
                    <button type="button" class="btn btn-secondary btn-small" onclick="keyManager.importKeys()">📥 Import Keys</button>
                    <button type="button" class="btn btn-danger btn-small" onclick="clearAllKeys()">🗑️ Clear All</button>
                </div>
            </div>

            <!-- Stored Keys Section -->
            <div class="section">
                <h2>📚 Your Stored Keys</h2>
                <div id="keys-list" class="keys-list">
                    <!-- Stored keys will be displayed here -->
                </div>
            </div>

            <!-- Debug Section -->
            <div class="section">
                <h2>🐛 Debug & Testing</h2>
                <div class="action-buttons">
                    <button type="button" class="btn btn-secondary" onclick="generateRandomString()">🎲 Random String</button>
                    <button type="button" class="btn btn-secondary" onclick="keyManager.debugStorage()">🐛 Debug Storage</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert placeholder -->
    <div id="alert-placeholder"></div>

    <script type="module">
        console.log('🔑 Key Management System initialized');

        // Bundled dependencies for standalone operation
        // Include StorageService and KeyManager code here for standalone operation
        
        // Since this is a standalone page, we'll use localStorage fallback
        class StorageService {
            static async getInstance() {
                return {
                    async get(key) {
                        const item = localStorage.getItem(key);
                        return item ? JSON.parse(item) : undefined;
                    },
                    async set(key, value) {
                        localStorage.setItem(key, JSON.stringify(value));
                    },
                    async delete(key) {
                        localStorage.removeItem(key);
                    }
                };
            }
        }

        // Key management classes (simplified for standalone)
        class KeyCrypto {
            static async encryptData(data, password) {
                // Simple encryption for demo - NOT production ready
                const encoder = new TextEncoder();
                const dataBytes = encoder.encode(JSON.stringify(data));
                const passwordBytes = encoder.encode(password);
                
                // XOR encryption for demo
                const encrypted = new Uint8Array(dataBytes.length);
                for (let i = 0; i < dataBytes.length; i++) {
                    encrypted[i] = dataBytes[i] ^ passwordBytes[i % passwordBytes.length];
                }
                
                return btoa(String.fromCharCode(...encrypted));
            }
            
            static async decryptData(encryptedData, password) {
                try {
                    const encrypted = new Uint8Array(atob(encryptedData).split('').map(c => c.charCodeAt(0)));
                    const passwordBytes = new TextEncoder().encode(password);
                    
                    const decrypted = new Uint8Array(encrypted.length);
                    for (let i = 0; i < encrypted.length; i++) {
                        decrypted[i] = encrypted[i] ^ passwordBytes[i % passwordBytes.length];
                    }
                    
                    const jsonString = new TextDecoder().decode(decrypted);
                    return JSON.parse(jsonString);
                } catch (error) {
                    throw new Error('Decryption failed');
                }
            }
        }

        class KeyManager {
            static async createKey(expirationDate, customString, password) {
                const data = {
                    customString,
                    expirationDate,
                    createdAt: new Date(),
                    version: 2
                };
                
                const encryptedData = await KeyCrypto.encryptData(data, password);
                const key = `EXPERT_KEY_V2_${encryptedData}`;
                
                return { key, data };
            }
            
            static async validateKey(key, password) {
                try {
                    if (!key.startsWith('EXPERT_KEY_V2_')) {
                        return { valid: false, reason: 'Invalid key format' };
                    }
                    
                    const encryptedData = key.replace('EXPERT_KEY_V2_', '');
                    const data = await KeyCrypto.decryptData(encryptedData, password);
                    
                    // Convert date strings back to Date objects
                    data.expirationDate = new Date(data.expirationDate);
                    data.createdAt = new Date(data.createdAt);
                    
                    const now = new Date();
                    if (data.expirationDate <= now) {
                        return { valid: false, reason: 'Key has expired', data };
                    }
                    
                    return { valid: true, data };
                } catch (error) {
                    return { valid: false, reason: error.message };
                }
            }
            
            static generateRandomString(length = 12) {
                const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
                let result = '';
                for (let i = 0; i < length; i++) {
                    result += chars.charAt(Math.floor(Math.random() * chars.length));
                }
                return result;
            }
        }

        class KeyStorage {
            static STORAGE_KEY = 'expert_generated_keys';
            
            static async saveKey(key, data, nickname) {
                const storedKey = {
                    key,
                    data,
                    id: Date.now().toString(),
                    nickname
                };
                
                const keys = await this.loadKeys();
                keys.unshift(storedKey);
                
                const storage = await StorageService.getInstance();
                await storage.set(this.STORAGE_KEY, keys);
                return storedKey.id;
            }
            
            static async loadKeys() {
                const storage = await StorageService.getInstance();
                const keys = await storage.get(this.STORAGE_KEY) || [];
                return keys.map(key => ({
                    ...key,
                    data: {
                        ...key.data,
                        expirationDate: new Date(key.data.expirationDate),
                        createdAt: new Date(key.data.createdAt)
                    }
                }));
            }
            
            static async deleteKey(id) {
                const keys = await this.loadKeys();
                const filteredKeys = keys.filter(key => key.id !== id);
                
                const storage = await StorageService.getInstance();
                await storage.set(this.STORAGE_KEY, filteredKeys);
                return true;
            }
            
            static async getStorageStats() {
                const keys = await this.loadKeys();
                const now = new Date();
                const validKeys = keys.filter(key => key.data.expirationDate > now);
                const expiredKeys = keys.filter(key => key.data.expirationDate <= now);
                
                return {
                    totalKeys: keys.length,
                    validKeys: validKeys.length,
                    expiredKeys: expiredKeys.length,
                    storageSize: JSON.stringify(keys).length
                };
            }
            
            static async cleanupExpiredKeys() {
                const keys = await this.loadKeys();
                const now = new Date();
                const validKeys = keys.filter(key => key.data.expirationDate > now);
                const removedCount = keys.length - validKeys.length;
                
                if (removedCount > 0) {
                    const storage = await StorageService.getInstance();
                    await storage.set(this.STORAGE_KEY, validKeys);
                }
                
                return removedCount;
            }
            
            static async exportKeys() {
                const keys = await this.loadKeys();
                return JSON.stringify(keys, null, 2);
            }
            
            static async importKeys(jsonData) {
                try {
                    const importedKeys = JSON.parse(jsonData);
                    const existingKeys = await this.loadKeys();
                    
                    // Simple append for demo
                    const allKeys = [...existingKeys, ...importedKeys];
                    
                    const storage = await StorageService.getInstance();
                    await storage.set(this.STORAGE_KEY, allKeys);
                    
                    return { success: true, imported: importedKeys.length, errors: [] };
                } catch (error) {
                    return { success: false, imported: 0, errors: [error.message] };
                }
            }
            
            static async clearAllKeys() {
                const storage = await StorageService.getInstance();
                await storage.delete(this.STORAGE_KEY);
            }
        }

        // UI Manager class
        class KeysUI {
            constructor() {
                this.init();
            }
            
            async init() {
                this.attachEventListeners();
                await this.updateKeysList();
                await this.updateStorageStats();
            }
            
            attachEventListeners() {
                document.getElementById('create-key-form').addEventListener('submit', (e) => this.handleCreateKey(e));
                document.getElementById('key-input').addEventListener('input', () => this.validateKey());
                document.getElementById('validation-password').addEventListener('input', () => this.validateKey());
            }
            
            async handleCreateKey(e) {
                e.preventDefault();
                
                const nickname = document.getElementById('nickname').value.trim();
                const customString = document.getElementById('custom-string').value;
                const password = document.getElementById('password').value;
                const expirationDate = new Date(document.getElementById('expiration-date').value);
                
                if (!customString || !password || !expirationDate || isNaN(expirationDate.getTime())) {
                    this.showError('Please fill in all fields');
                    return;
                }
                
                if (password.length < 4) {
                    this.showError('Password must be at least 4 characters long');
                    return;
                }
                
                if (expirationDate <= new Date()) {
                    this.showError('Expiration date must be in the future');
                    return;
                }
                
                try {
                    const result = await KeyManager.createKey(expirationDate, customString, password);
                    await KeyStorage.saveKey(result.key, result.data, nickname || undefined);
                    
                    await this.updateKeysList();
                    await this.updateStorageStats();
                    this.showSuccess('Key created successfully!');
                    
                    document.getElementById('create-key-form').reset();
                } catch (error) {
                    this.showError('Failed to create key: ' + error.message);
                }
            }
            
            async validateKey() {
                const key = document.getElementById('key-input').value.trim();
                const password = document.getElementById('validation-password').value;
                const resultDiv = document.getElementById('validation-result');
                
                if (!key || !password) {
                    resultDiv.innerHTML = '';
                    return;
                }
                
                const validation = await KeyManager.validateKey(key, password);
                
                if (validation.valid && validation.data) {
                    resultDiv.innerHTML = `
                        <div class="validation-result valid">
                            <h3>✅ Valid Key</h3>
                            <p><strong>String:</strong> "${validation.data.customString}"</p>
                            <p><strong>Expires:</strong> ${validation.data.expirationDate.toLocaleString()}</p>
                            <p><strong>Created:</strong> ${validation.data.createdAt.toLocaleString()}</p>
                        </div>
                    `;
                } else {
                    resultDiv.innerHTML = `
                        <div class="validation-result invalid">
                            <h3>❌ Invalid Key</h3>
                            <p><strong>Reason:</strong> ${validation.reason}</p>
                        </div>
                    `;
                }
            }
            
            async updateKeysList() {
                const keysList = document.getElementById('keys-list');
                const keys = await KeyStorage.loadKeys();
                
                if (keys.length === 0) {
                    keysList.innerHTML = '<p style="text-align: center; color: #718096; padding: 2rem;">No keys stored yet</p>';
                    return;
                }
                
                keysList.innerHTML = keys.map(storedKey => {
                    const isExpired = storedKey.data.expirationDate <= new Date();
                    const statusClass = isExpired ? 'status-expired' : 'status-valid';
                    const statusText = isExpired ? 'Expired' : 'Valid';
                    
                    return `
                        <div class="key-item">
                            <div class="key-header">
                                <div class="key-nickname">${storedKey.nickname || 'Unnamed Key'}</div>
                                <div class="key-actions">
                                    <button class="btn btn-secondary btn-small copy-btn" data-key="${storedKey.key}">📋 Copy</button>
                                    <button class="btn btn-danger btn-small delete-btn" data-id="${storedKey.id}">🗑️ Delete</button>
                                </div>
                            </div>
                            <div class="key-info">
                                <div><strong>String:</strong> "${storedKey.data.customString}"</div>
                                <div><strong>Expires:</strong> ${storedKey.data.expirationDate.toLocaleString()}</div>
                                <div><strong>Status:</strong> <span class="status-indicator ${statusClass}">${statusText}</span></div>
                                <div><strong>Length:</strong> ${storedKey.key.length} chars</div>
                            </div>
                            <div class="key-display">${storedKey.key}</div>
                        </div>
                    `;
                }).join('');
                
                // Add event listeners for copy and delete buttons
                keysList.addEventListener('click', async (e) => {
                    if (e.target.classList.contains('copy-btn')) {
                        const key = e.target.dataset.key;
                        this.copyToClipboard(key, e.target);
                    } else if (e.target.classList.contains('delete-btn')) {
                        const id = e.target.dataset.id;
                        if (confirm('Are you sure you want to delete this key?')) {
                            await KeyStorage.deleteKey(id);
                            await this.updateKeysList();
                            await this.updateStorageStats();
                            this.showSuccess('Key deleted successfully');
                        }
                    }
                });
            }
            
            copyToClipboard(text, button) {
                // Use fallback method to avoid clipboard API issues
                const textArea = document.createElement('textarea');
                textArea.value = text;
                textArea.style.position = 'fixed';
                textArea.style.left = '-999999px';
                textArea.style.top = '-999999px';
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                
                try {
                    document.execCommand('copy');
                    button.textContent = '✅ Copied!';
                    setTimeout(() => {
                        button.textContent = '📋 Copy';
                    }, 2000);
                } catch (error) {
                    this.showError('Failed to copy');
                } finally {
                    document.body.removeChild(textArea);
                }
            }
            
            async updateStorageStats() {
                const statsContainer = document.getElementById('storage-stats');
                const stats = await KeyStorage.getStorageStats();
                
                statsContainer.innerHTML = `
                    <div style="background: #f0fff4; padding: 1rem; border-radius: 8px; text-align: center;">
                        <div style="font-size: 1.5rem; font-weight: bold; color: #22543d;">${stats.totalKeys}</div>
                        <div style="font-size: 0.8rem; color: #68d391;">Total Keys</div>
                    </div>
                    <div style="background: #f0f9ff; padding: 1rem; border-radius: 8px; text-align: center;">
                        <div style="font-size: 1.5rem; font-weight: bold; color: #1e40af;">${stats.validKeys}</div>
                        <div style="font-size: 0.8rem; color: #60a5fa;">Valid Keys</div>
                    </div>
                    <div style="background: #fef3c7; padding: 1rem; border-radius: 8px; text-align: center;">
                        <div style="font-size: 1.5rem; font-weight: bold; color: #d97706;">${stats.expiredKeys}</div>
                        <div style="font-size: 0.8rem; color: #fbbf24;">Expired Keys</div>
                    </div>
                    <div style="background: #f3f4f6; padding: 1rem; border-radius: 8px; text-align: center;">
                        <div style="font-size: 1.5rem; font-weight: bold; color: #4b5563;">${(stats.storageSize / 1024).toFixed(1)}KB</div>
                        <div style="font-size: 0.8rem; color: #6b7280;">Storage Used</div>
                    </div>
                `;
            }
            
            async cleanupExpiredKeys() {
                const removedCount = await KeyStorage.cleanupExpiredKeys();
                if (removedCount > 0) {
                    await this.updateKeysList();
                    await this.updateStorageStats();
                    this.showSuccess(`Removed ${removedCount} expired key${removedCount > 1 ? 's' : ''}`);
                } else {
                    this.showSuccess('No expired keys to remove');
                }
            }
            
            async exportKeys() {
                try {
                    const exportData = await KeyStorage.exportKeys();
                    const blob = new Blob([exportData], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `expert-keys-${new Date().toISOString().split('T')[0]}.json`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                    
                    this.showSuccess('Keys exported successfully');
                } catch (error) {
                    this.showError('Failed to export keys');
                }
            }
            
            importKeys() {
                const input = document.createElement('input');
                input.type = 'file';
                input.accept = '.json';
                
                input.addEventListener('change', async (e) => {
                    const file = e.target.files[0];
                    if (!file) return;
                    
                    try {
                        const text = await file.text();
                        const result = await KeyStorage.importKeys(text);
                        
                        if (result.success) {
                            await this.updateKeysList();
                            await this.updateStorageStats();
                            this.showSuccess(`Imported ${result.imported} keys`);
                        } else {
                            this.showError('Import failed');
                        }
                    } catch (error) {
                        this.showError('Failed to read file');
                    }
                });
                
                input.click();
            }
            
            debugStorage() {
                console.log('🐛 Debug Storage');
                alert('Debug info in console');
            }
            
            showSuccess(message) {
                this.showToast(message, '#48bb78');
            }
            
            showError(message) {
                this.showToast(message, '#f56565');
            }
            
            showToast(message, color) {
                const toast = document.createElement('div');
                toast.style.cssText = `
                    position: fixed; top: 2rem; right: 2rem; padding: 1rem 1.5rem;
                    background: ${color}; color: white; border-radius: 8px;
                    font-weight: 600; z-index: 1000; transform: translateX(100%);
                    transition: transform 0.3s ease; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
                `;
                toast.textContent = message;
                
                document.body.appendChild(toast);
                setTimeout(() => toast.style.transform = 'translateX(0)', 100);
                setTimeout(() => {
                    toast.style.transform = 'translateX(100%)';
                    setTimeout(() => document.body.removeChild(toast), 300);
                }, 3000);
            }
        }

                 // Access control functionality  
         // Hash for %PyrionExpert65% using simple fallback hash
         const EXPECTED_PASSWORD_HASH = '2b093d282b093d282b093d282b093d282b093d282b093d282b093d282b093d28';
         
         // Simple hash function for password verification
         async function hashPassword(password) {
             // Simple hash function (not cryptographically secure, but works over HTTP)
             let hash = 0;
             for (let i = 0; i < password.length; i++) {
                 const char = password.charCodeAt(i);
                 hash = ((hash << 5) - hash) + char;
                 hash = hash & hash; // Convert to 32-bit integer
             }
             // Convert to hex and pad to match expected format
             return Math.abs(hash).toString(16).padStart(8, '0').repeat(8).slice(0, 64);
         }
         
         window.verifyAccess = async function() {
             const passwordInput = document.getElementById('access-password');
             const password = passwordInput.value;
             const resultDiv = document.getElementById('access-result');
             
             if (!password) {
                 resultDiv.innerHTML = '<div class="validation-result invalid"><h3>❌ Error</h3><p>Please enter a password</p></div>';
                 return;
             }
             
             try {
                 const enteredHash = await hashPassword(password);
                 
                 if (enteredHash === EXPECTED_PASSWORD_HASH) {
                     // Access granted
                     document.getElementById('access-control-section').style.display = 'none';
                     document.getElementById('key-creation-section').style.display = 'block';
                     
                     resultDiv.innerHTML = '<div class="validation-result valid"><h3>✅ Access Granted</h3><p>Key generator unlocked</p></div>';
                     
                     // Store access state in session
                     sessionStorage.setItem('keyGenerator_access', 'granted');
                 } else {
                     resultDiv.innerHTML = '<div class="validation-result invalid"><h3>❌ Access Denied</h3><p>Incorrect password</p></div>';
                     passwordInput.value = '';
                 }
             } catch (error) {
                 console.error('🔐 Authentication error:', error);
                 resultDiv.innerHTML = '<div class="validation-result invalid"><h3>❌ Error</h3><p>Authentication failed: ' + error.message + '</p></div>';
             }
         };
         
         // Check for existing access on page load
         function checkExistingAccess() {
             if (sessionStorage.getItem('keyGenerator_access') === 'granted') {
                 document.getElementById('access-control-section').style.display = 'none';
                 document.getElementById('key-creation-section').style.display = 'block';
             }
         }
         
         // Global functions for onclick handlers
         window.keyManager = new KeysUI();
         
         // Check access on page load
         checkExistingAccess();
        
                 window.setPresetDate = function(days) {
             const date = new Date(Date.now() + days * 24 * 60 * 60 * 1000);
             document.getElementById('expiration-date').value = date.toISOString().slice(0, 16);
         };
         
         window.setUnlimitedDate = function() {
             // Set to December 31, 2099 - effectively unlimited for practical purposes
             const unlimitedDate = new Date(2099, 11, 31, 23, 59, 59); // Month is 0-indexed, so 11 = December
             document.getElementById('expiration-date').value = unlimitedDate.toISOString().slice(0, 16);
         };
        
        window.validateKey = function() {
            keyManager.validateKey();
        };
        
        window.generateRandomString = function() {
            document.getElementById('custom-string').value = KeyManager.generateRandomString(12);
        };
        
        window.clearAllKeys = async function() {
            if (confirm('Are you sure you want to delete ALL stored keys? This cannot be undone.')) {
                await KeyStorage.clearAllKeys();
                await keyManager.updateKeysList();
                await keyManager.updateStorageStats();
                keyManager.showSuccess('All keys cleared');
            }
        };
    </script>
</body>
</html>
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 2rem;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 2rem;
            text-align: center;
        }

        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            font-weight: 300;
        }

        .header p {
            opacity: 0.9;
            font-size: 1.1rem;
        }

        .content {
            padding: 2rem;
        }

        .section {
            margin-bottom: 3rem;
        }

        .section h2 {
            color: #2d3748;
            margin-bottom: 1.5rem;
            font-size: 1.5rem;
            font-weight: 600;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 0.5rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #4a5568;
        }

        input[type="text"],
        input[type="password"],
        input[type="datetime-local"],
        textarea {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.2s ease;
            background-color: white;
        }

        input[type="text"]:focus,
        input[type="password"]:focus,
        input[type="datetime-local"]:focus,
        textarea:focus {
            outline: none;
            border-color: #4299e1;
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.1);
        }

        .preset-buttons {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.5rem;
            flex-wrap: wrap;
        }

        .preset-btn {
            padding: 0.25rem 0.75rem;
            border: 1px solid #cbd5e0;
            border-radius: 20px;
            background: white;
            color: #4a5568;
            cursor: pointer;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .preset-btn:hover {
            background: #f7fafc;
            border-color: #a0aec0;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }

        .btn-primary {
            background: linear-gradient(135deg, #4299e1 0%, #3182ce 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(66, 153, 225, 0.3);
        }

        .btn-secondary {
            background: #f7fafc;
            color: #4a5568;
            border: 2px solid #e2e8f0;
        }

        .btn-secondary:hover {
            background: #edf2f7;
            border-color: #cbd5e0;
        }

        .btn-danger {
            background: #fc8181;
            color: white;
        }

        .btn-danger:hover {
            background: #f56565;
        }

        .btn-small {
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
        }

        .validation-section {
            background: #f8fafc;
            padding: 1.5rem;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
        }

        .validation-result {
            margin-top: 1rem;
            padding: 1rem;
            border-radius: 8px;
            font-weight: 600;
        }

        .validation-result.valid {
            background: #c6f6d5;
            color: #22543d;
            border: 1px solid #9ae6b4;
        }

        .validation-result.invalid {
            background: #fed7d7;
            color: #742a2a;
            border: 1px solid #fc8181;
        }

        .alert {
            padding: 1rem;
            border-radius: 8px;
            margin: 1rem 0;
            font-weight: 600;
        }

        .alert-success {
            background: #c6f6d5;
            color: #22543d;
            border: 1px solid #9ae6b4;
        }

        .alert-error {
            background: #fed7d7;
            color: #742a2a;
            border: 1px solid #fc8181;
        }

        .storage-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin: 1rem 0;
        }

        .keys-list {
            max-height: 400px;
            overflow-y: auto;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
        }

        .key-item {
            padding: 1rem;
            border-bottom: 1px solid #f7fafc;
            background: white;
        }

        .key-item:last-child {
            border-bottom: none;
        }

        .key-item:hover {
            background: #f8fafc;
        }

        .key-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.5rem;
        }

        .key-nickname {
            font-weight: 600;
            color: #2d3748;
            font-size: 1.1rem;
        }

        .key-actions {
            display: flex;
            gap: 0.5rem;
            flex-shrink: 0;
        }

        .key-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.875rem;
            color: #4a5568;
        }

        .key-display {
            background: #f7fafc;
            padding: 0.75rem;
            border-radius: 6px;
            font-family: 'Courier New', monospace;
            font-size: 0.875rem;
            word-break: break-all;
            border: 1px solid #e2e8f0;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        .management-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .status-indicator {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-valid {
            background: #c6f6d5;
            color: #22543d;
        }

        .status-expired {
            background: #fed7d7;
            color: #742a2a;
        }

        .status-expiring {
            background: #fef5e7;
            color: #c05621;
        }

        .copy-btn, .delete-btn {
            font-size: 0.875rem;
        }

        /* Mobile responsiveness */
        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }

            .header {
                padding: 1.5rem;
            }

            .header h1 {
                font-size: 2rem;
            }

            .content {
                padding: 1.5rem;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
            }

            .management-actions {
                grid-template-columns: 1fr;
            }

            .storage-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .key-header {
                flex-direction: column;
                gap: 0.5rem;
            }

            .key-actions {
                align-self: flex-start;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔑 Key Management System</h1>
            <p>Create and manage encrypted keys with expiration dates</p>
        </div>

        <div class="content">
            <!-- Access Control Section -->
            <div class="section" id="access-control-section">
                <h2>🔒 Access Control</h2>
                <div class="validation-section">
                    <div class="form-group">
                        <label for="access-password">Enter Access Password</label>
                        <input type="password" id="access-password" placeholder="Enter password to access key generator">
                    </div>
                    <button type="button" class="btn btn-primary" onclick="verifyAccess()">🔓 Unlock Key Generator</button>
                    <div id="access-result"></div>
                </div>
            </div>

            <!-- Key Creation Section -->
            <div class="section" id="key-creation-section" style="display: none;">
                <h2>🆕 Create New Key</h2>
                <form id="create-key-form">
                    <div class="form-group">
                        <label for="nickname">Nickname (optional)</label>
                        <input type="text" id="nickname" placeholder="Enter a nickname for this key">
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="custom-string">String to Encode</label>
                            <input type="text" id="custom-string" placeholder="Enter the string to encode" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="password">Password</label>
                            <input type="password" id="password" placeholder="Enter password (min 4 chars)" value="ExperT" required>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="expiration-date">Expiration Date</label>
                        <input type="datetime-local" id="expiration-date" required>
                        <div class="preset-buttons">
                            <button type="button" class="preset-btn" onclick="setPresetDate(7)">+7 days</button>
                            <button type="button" class="preset-btn" onclick="setPresetDate(30)">+30 days</button>
                            <button type="button" class="preset-btn" onclick="setPresetDate(90)">+90 days</button>
                            <button type="button" class="preset-btn" onclick="setUnlimitedDate()">Unlimited</button>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary">🔑 Create Key</button>
                </form>
            </div>

            <!-- Key Validation Section -->
            <div class="section">
                <h2>🔍 Validate Key</h2>
                <div class="validation-section">
                    <div class="form-group">
                        <label for="key-input">Enter Key to Validate</label>
                        <textarea id="key-input" rows="3" placeholder="Paste your key here..."></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label for="validation-password">Password</label>
                        <input type="password" id="validation-password" placeholder="Enter password to decode" value="ExperT">
                    </div>
                    
                    <button type="button" class="btn btn-secondary" onclick="validateKey()">🔍 Validate Key</button>
                    
                    <div id="validation-result"></div>
                </div>
            </div>

            <!-- Storage Management Section -->
            <div class="section">
                <h2>💾 Storage Management</h2>
                
                <div id="storage-stats" class="storage-stats">
                    <!-- Storage stats will be populated here -->
                </div>
                
                <div class="management-actions">
                    <button type="button" class="btn btn-secondary btn-small" onclick="keyManager.cleanupExpiredKeys()">🧹 Cleanup Expired</button>
                    <button type="button" class="btn btn-secondary btn-small" onclick="keyManager.exportKeys()">📤 Export Keys</button>
                    <button type="button" class="btn btn-secondary btn-small" onclick="keyManager.importKeys()">📥 Import Keys</button>
                    <button type="button" class="btn btn-danger btn-small" onclick="clearAllKeys()">🗑️ Clear All</button>
                </div>
            </div>

            <!-- Stored Keys Section -->
            <div class="section">
                <h2>📚 Your Stored Keys</h2>
                <div id="keys-list" class="keys-list">
                    <!-- Stored keys will be displayed here -->
                </div>
            </div>

            <!-- Debug Section -->
            <div class="section">
                <h2>🐛 Debug & Testing</h2>
                <div class="action-buttons">
                    <button type="button" class="btn btn-secondary" onclick="generateRandomString()">🎲 Random String</button>
                    <button type="button" class="btn btn-secondary" onclick="keyManager.debugStorage()">🐛 Debug Storage</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert placeholder -->
    <div id="alert-placeholder"></div>

    <script type="module">
        console.log('🔑 Key Management System initialized');

        // Bundled dependencies for standalone operation
        // Include StorageService and KeyManager code here for standalone operation
        
        // Since this is a standalone page, we'll use localStorage fallback
        class StorageService {
            static async getInstance() {
                return {
                    async get(key) {
                        const item = localStorage.getItem(key);
                        return item ? JSON.parse(item) : undefined;
                    },
                    async set(key, value) {
                        localStorage.setItem(key, JSON.stringify(value));
                    },
                    async delete(key) {
                        localStorage.removeItem(key);
                    }
                };
            }
        }

        // Key management classes (simplified for standalone)
        class KeyCrypto {
            static async encryptData(data, password) {
                // Simple encryption for demo - NOT production ready
                const encoder = new TextEncoder();
                const dataBytes = encoder.encode(JSON.stringify(data));
                const passwordBytes = encoder.encode(password);
                
                // XOR encryption for demo
                const encrypted = new Uint8Array(dataBytes.length);
                for (let i = 0; i < dataBytes.length; i++) {
                    encrypted[i] = dataBytes[i] ^ passwordBytes[i % passwordBytes.length];
                }
                
                return btoa(String.fromCharCode(...encrypted));
            }
            
            static async decryptData(encryptedData, password) {
                try {
                    const encrypted = new Uint8Array(atob(encryptedData).split('').map(c => c.charCodeAt(0)));
                    const passwordBytes = new TextEncoder().encode(password);
                    
                    const decrypted = new Uint8Array(encrypted.length);
                    for (let i = 0; i < encrypted.length; i++) {
                        decrypted[i] = encrypted[i] ^ passwordBytes[i % passwordBytes.length];
                    }
                    
                    const jsonString = new TextDecoder().decode(decrypted);
                    return JSON.parse(jsonString);
                } catch (error) {
                    throw new Error('Decryption failed');
                }
            }
        }

        class KeyManager {
            static async createKey(expirationDate, customString, password) {
                const data = {
                    customString,
                    expirationDate,
                    createdAt: new Date(),
                    version: 2
                };
                
                const encryptedData = await KeyCrypto.encryptData(data, password);
                const key = `EXPERT_KEY_V2_${encryptedData}`;
                
                return { key, data };
            }
            
            static async validateKey(key, password) {
                try {
                    if (!key.startsWith('EXPERT_KEY_V2_')) {
                        return { valid: false, reason: 'Invalid key format' };
                    }
                    
                    const encryptedData = key.replace('EXPERT_KEY_V2_', '');
                    const data = await KeyCrypto.decryptData(encryptedData, password);
                    
                    // Convert date strings back to Date objects
                    data.expirationDate = new Date(data.expirationDate);
                    data.createdAt = new Date(data.createdAt);
                    
                    const now = new Date();
                    if (data.expirationDate <= now) {
                        return { valid: false, reason: 'Key has expired', data };
                    }
                    
                    return { valid: true, data };
                } catch (error) {
                    return { valid: false, reason: error.message };
                }
            }
            
            static generateRandomString(length = 12) {
                const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
                let result = '';
                for (let i = 0; i < length; i++) {
                    result += chars.charAt(Math.floor(Math.random() * chars.length));
                }
                return result;
            }
        }

        class KeyStorage {
            static STORAGE_KEY = 'expert_generated_keys';
            
            static async saveKey(key, data, nickname) {
                const storedKey = {
                    key,
                    data,
                    id: Date.now().toString(),
                    nickname
                };
                
                const keys = await this.loadKeys();
                keys.unshift(storedKey);
                
                const storage = await StorageService.getInstance();
                await storage.set(this.STORAGE_KEY, keys);
                return storedKey.id;
            }
            
            static async loadKeys() {
                const storage = await StorageService.getInstance();
                const keys = await storage.get(this.STORAGE_KEY) || [];
                return keys.map(key => ({
                    ...key,
                    data: {
                        ...key.data,
                        expirationDate: new Date(key.data.expirationDate),
                        createdAt: new Date(key.data.createdAt)
                    }
                }));
            }
            
            static async deleteKey(id) {
                const keys = await this.loadKeys();
                const filteredKeys = keys.filter(key => key.id !== id);
                
                const storage = await StorageService.getInstance();
                await storage.set(this.STORAGE_KEY, filteredKeys);
                return true;
            }
            
            static async getStorageStats() {
                const keys = await this.loadKeys();
                const now = new Date();
                const validKeys = keys.filter(key => key.data.expirationDate > now);
                const expiredKeys = keys.filter(key => key.data.expirationDate <= now);
                
                return {
                    totalKeys: keys.length,
                    validKeys: validKeys.length,
                    expiredKeys: expiredKeys.length,
                    storageSize: JSON.stringify(keys).length
                };
            }
            
            static async cleanupExpiredKeys() {
                const keys = await this.loadKeys();
                const now = new Date();
                const validKeys = keys.filter(key => key.data.expirationDate > now);
                const removedCount = keys.length - validKeys.length;
                
                if (removedCount > 0) {
                    const storage = await StorageService.getInstance();
                    await storage.set(this.STORAGE_KEY, validKeys);
                }
                
                return removedCount;
            }
            
            static async exportKeys() {
                const keys = await this.loadKeys();
                return JSON.stringify(keys, null, 2);
            }
            
            static async importKeys(jsonData) {
                try {
                    const importedKeys = JSON.parse(jsonData);
                    const existingKeys = await this.loadKeys();
                    
                    // Simple append for demo
                    const allKeys = [...existingKeys, ...importedKeys];
                    
                    const storage = await StorageService.getInstance();
                    await storage.set(this.STORAGE_KEY, allKeys);
                    
                    return { success: true, imported: importedKeys.length, errors: [] };
                } catch (error) {
                    return { success: false, imported: 0, errors: [error.message] };
                }
            }
            
            static async clearAllKeys() {
                const storage = await StorageService.getInstance();
                await storage.delete(this.STORAGE_KEY);
            }
        }

        // UI Manager class
        class KeysUI {
            constructor() {
                this.init();
            }
            
            async init() {
                this.attachEventListeners();
                await this.updateKeysList();
                await this.updateStorageStats();
            }
            
            attachEventListeners() {
                document.getElementById('create-key-form').addEventListener('submit', (e) => this.handleCreateKey(e));
                document.getElementById('key-input').addEventListener('input', () => this.validateKey());
                document.getElementById('validation-password').addEventListener('input', () => this.validateKey());
            }
            
            async handleCreateKey(e) {
                e.preventDefault();
                
                const nickname = document.getElementById('nickname').value.trim();
                const customString = document.getElementById('custom-string').value;
                const password = document.getElementById('password').value;
                const expirationDate = new Date(document.getElementById('expiration-date').value);
                
                if (!customString || !password || !expirationDate || isNaN(expirationDate.getTime())) {
                    this.showError('Please fill in all fields');
                    return;
                }
                
                if (password.length < 4) {
                    this.showError('Password must be at least 4 characters long');
                    return;
                }
                
                if (expirationDate <= new Date()) {
                    this.showError('Expiration date must be in the future');
                    return;
                }
                
                try {
                    const result = await KeyManager.createKey(expirationDate, customString, password);
                    await KeyStorage.saveKey(result.key, result.data, nickname || undefined);
                    
                    await this.updateKeysList();
                    await this.updateStorageStats();
                    this.showSuccess('Key created successfully!');
                    
                    document.getElementById('create-key-form').reset();
                } catch (error) {
                    this.showError('Failed to create key: ' + error.message);
                }
            }
            
            async validateKey() {
                const key = document.getElementById('key-input').value.trim();
                const password = document.getElementById('validation-password').value;
                const resultDiv = document.getElementById('validation-result');
                
                if (!key || !password) {
                    resultDiv.innerHTML = '';
                    return;
                }
                
                const validation = await KeyManager.validateKey(key, password);
                
                if (validation.valid && validation.data) {
                    resultDiv.innerHTML = `
                        <div class="validation-result valid">
                            <h3>✅ Valid Key</h3>
                            <p><strong>String:</strong> "${validation.data.customString}"</p>
                            <p><strong>Expires:</strong> ${validation.data.expirationDate.toLocaleString()}</p>
                            <p><strong>Created:</strong> ${validation.data.createdAt.toLocaleString()}</p>
                        </div>
                    `;
                } else {
                    resultDiv.innerHTML = `
                        <div class="validation-result invalid">
                            <h3>❌ Invalid Key</h3>
                            <p><strong>Reason:</strong> ${validation.reason}</p>
                        </div>
                    `;
                }
            }
            
            async updateKeysList() {
                const keysList = document.getElementById('keys-list');
                const keys = await KeyStorage.loadKeys();
                
                if (keys.length === 0) {
                    keysList.innerHTML = '<p style="text-align: center; color: #718096; padding: 2rem;">No keys stored yet</p>';
                    return;
                }
                
                keysList.innerHTML = keys.map(storedKey => {
                    const isExpired = storedKey.data.expirationDate <= new Date();
                    const statusClass = isExpired ? 'status-expired' : 'status-valid';
                    const statusText = isExpired ? 'Expired' : 'Valid';
                    
                    return `
                        <div class="key-item">
                            <div class="key-header">
                                <div class="key-nickname">${storedKey.nickname || 'Unnamed Key'}</div>
                                <div class="key-actions">
                                    <button class="btn btn-secondary btn-small copy-btn" data-key="${storedKey.key}">📋 Copy</button>
                                    <button class="btn btn-danger btn-small delete-btn" data-id="${storedKey.id}">🗑️ Delete</button>
                                </div>
                            </div>
                            <div class="key-info">
                                <div><strong>String:</strong> "${storedKey.data.customString}"</div>
                                <div><strong>Expires:</strong> ${storedKey.data.expirationDate.toLocaleString()}</div>
                                <div><strong>Status:</strong> <span class="status-indicator ${statusClass}">${statusText}</span></div>
                                <div><strong>Length:</strong> ${storedKey.key.length} chars</div>
                            </div>
                            <div class="key-display">${storedKey.key}</div>
                        </div>
                    `;
                }).join('');
                
                // Add event listeners for copy and delete buttons
                keysList.addEventListener('click', async (e) => {
                    if (e.target.classList.contains('copy-btn')) {
                        const key = e.target.dataset.key;
                        this.copyToClipboard(key, e.target);
                    } else if (e.target.classList.contains('delete-btn')) {
                        const id = e.target.dataset.id;
                        if (confirm('Are you sure you want to delete this key?')) {
                            await KeyStorage.deleteKey(id);
                            await this.updateKeysList();
                            await this.updateStorageStats();
                            this.showSuccess('Key deleted successfully');
                        }
                    }
                });
            }
            
            copyToClipboard(text, button) {
                // Use fallback method to avoid clipboard API issues
                const textArea = document.createElement('textarea');
                textArea.value = text;
                textArea.style.position = 'fixed';
                textArea.style.left = '-999999px';
                textArea.style.top = '-999999px';
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                
                try {
                    document.execCommand('copy');
                    button.textContent = '✅ Copied!';
                    setTimeout(() => {
                        button.textContent = '📋 Copy';
                    }, 2000);
                } catch (error) {
                    this.showError('Failed to copy');
                } finally {
                    document.body.removeChild(textArea);
                }
            }
            
            async updateStorageStats() {
                const statsContainer = document.getElementById('storage-stats');
                const stats = await KeyStorage.getStorageStats();
                
                statsContainer.innerHTML = `
                    <div style="background: #f0fff4; padding: 1rem; border-radius: 8px; text-align: center;">
                        <div style="font-size: 1.5rem; font-weight: bold; color: #22543d;">${stats.totalKeys}</div>
                        <div style="font-size: 0.8rem; color: #68d391;">Total Keys</div>
                    </div>
                    <div style="background: #f0f9ff; padding: 1rem; border-radius: 8px; text-align: center;">
                        <div style="font-size: 1.5rem; font-weight: bold; color: #1e40af;">${stats.validKeys}</div>
                        <div style="font-size: 0.8rem; color: #60a5fa;">Valid Keys</div>
                    </div>
                    <div style="background: #fef3c7; padding: 1rem; border-radius: 8px; text-align: center;">
                        <div style="font-size: 1.5rem; font-weight: bold; color: #d97706;">${stats.expiredKeys}</div>
                        <div style="font-size: 0.8rem; color: #fbbf24;">Expired Keys</div>
                    </div>
                    <div style="background: #f3f4f6; padding: 1rem; border-radius: 8px; text-align: center;">
                        <div style="font-size: 1.5rem; font-weight: bold; color: #4b5563;">${(stats.storageSize / 1024).toFixed(1)}KB</div>
                        <div style="font-size: 0.8rem; color: #6b7280;">Storage Used</div>
                    </div>
                `;
            }
            
            async cleanupExpiredKeys() {
                const removedCount = await KeyStorage.cleanupExpiredKeys();
                if (removedCount > 0) {
                    await this.updateKeysList();
                    await this.updateStorageStats();
                    this.showSuccess(`Removed ${removedCount} expired key${removedCount > 1 ? 's' : ''}`);
                } else {
                    this.showSuccess('No expired keys to remove');
                }
            }
            
            async exportKeys() {
                try {
                    const exportData = await KeyStorage.exportKeys();
                    const blob = new Blob([exportData], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `expert-keys-${new Date().toISOString().split('T')[0]}.json`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                    
                    this.showSuccess('Keys exported successfully');
                } catch (error) {
                    this.showError('Failed to export keys');
                }
            }
            
            importKeys() {
                const input = document.createElement('input');
                input.type = 'file';
                input.accept = '.json';
                
                input.addEventListener('change', async (e) => {
                    const file = e.target.files[0];
                    if (!file) return;
                    
                    try {
                        const text = await file.text();
                        const result = await KeyStorage.importKeys(text);
                        
                        if (result.success) {
                            await this.updateKeysList();
                            await this.updateStorageStats();
                            this.showSuccess(`Imported ${result.imported} keys`);
                        } else {
                            this.showError('Import failed');
                        }
                    } catch (error) {
                        this.showError('Failed to read file');
                    }
                });
                
                input.click();
            }
            
            debugStorage() {
                console.log('🐛 Debug Storage');
                alert('Debug info in console');
            }
            
            showSuccess(message) {
                this.showToast(message, '#48bb78');
            }
            
            showError(message) {
                this.showToast(message, '#f56565');
            }
            
            showToast(message, color) {
                const toast = document.createElement('div');
                toast.style.cssText = `
                    position: fixed; top: 2rem; right: 2rem; padding: 1rem 1.5rem;
                    background: ${color}; color: white; border-radius: 8px;
                    font-weight: 600; z-index: 1000; transform: translateX(100%);
                    transition: transform 0.3s ease; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
                `;
                toast.textContent = message;
                
                document.body.appendChild(toast);
                setTimeout(() => toast.style.transform = 'translateX(0)', 100);
                setTimeout(() => {
                    toast.style.transform = 'translateX(100%)';
                    setTimeout(() => document.body.removeChild(toast), 300);
                }, 3000);
            }
        }

                 // Access control functionality  
         // Hash for %PyrionExpert65% using simple fallback hash
         const EXPECTED_PASSWORD_HASH = '2b093d282b093d282b093d282b093d282b093d282b093d282b093d282b093d28';
         
         // Simple hash function for password verification
         async function hashPassword(password) {
             // Simple hash function (not cryptographically secure, but works over HTTP)
             let hash = 0;
             for (let i = 0; i < password.length; i++) {
                 const char = password.charCodeAt(i);
                 hash = ((hash << 5) - hash) + char;
                 hash = hash & hash; // Convert to 32-bit integer
             }
             // Convert to hex and pad to match expected format
             return Math.abs(hash).toString(16).padStart(8, '0').repeat(8).slice(0, 64);
         }
         
         window.verifyAccess = async function() {
             const passwordInput = document.getElementById('access-password');
             const password = passwordInput.value;
             const resultDiv = document.getElementById('access-result');
             
             if (!password) {
                 resultDiv.innerHTML = '<div class="validation-result invalid"><h3>❌ Error</h3><p>Please enter a password</p></div>';
                 return;
             }
             
             try {
                 const enteredHash = await hashPassword(password);
                 
                 if (enteredHash === EXPECTED_PASSWORD_HASH) {
                     // Access granted
                     document.getElementById('access-control-section').style.display = 'none';
                     document.getElementById('key-creation-section').style.display = 'block';
                     
                     resultDiv.innerHTML = '<div class="validation-result valid"><h3>✅ Access Granted</h3><p>Key generator unlocked</p></div>';
                     
                     // Store access state in session
                     sessionStorage.setItem('keyGenerator_access', 'granted');
                 } else {
                     resultDiv.innerHTML = '<div class="validation-result invalid"><h3>❌ Access Denied</h3><p>Incorrect password</p></div>';
                     passwordInput.value = '';
                 }
             } catch (error) {
                 console.error('🔐 Authentication error:', error);
                 resultDiv.innerHTML = '<div class="validation-result invalid"><h3>❌ Error</h3><p>Authentication failed: ' + error.message + '</p></div>';
             }
         };
         
         // Check for existing access on page load
         function checkExistingAccess() {
             if (sessionStorage.getItem('keyGenerator_access') === 'granted') {
                 document.getElementById('access-control-section').style.display = 'none';
                 document.getElementById('key-creation-section').style.display = 'block';
             }
         }
         
         // Global functions for onclick handlers
         window.keyManager = new KeysUI();
         
         // Check access on page load
         checkExistingAccess();
        
                 window.setPresetDate = function(days) {
             const date = new Date(Date.now() + days * 24 * 60 * 60 * 1000);
             document.getElementById('expiration-date').value = date.toISOString().slice(0, 16);
         };
         
         window.setUnlimitedDate = function() {
             // Set to December 31, 2099 - effectively unlimited for practical purposes
             const unlimitedDate = new Date(2099, 11, 31, 23, 59, 59); // Month is 0-indexed, so 11 = December
             document.getElementById('expiration-date').value = unlimitedDate.toISOString().slice(0, 16);
         };
        
        window.validateKey = function() {
            keyManager.validateKey();
        };
        
        window.generateRandomString = function() {
            document.getElementById('custom-string').value = KeyManager.generateRandomString(12);
        };
        
        window.clearAllKeys = async function() {
            if (confirm('Are you sure you want to delete ALL stored keys? This cannot be undone.')) {
                await KeyStorage.clearAllKeys();
                await keyManager.updateKeysList();
                await keyManager.updateStorageStats();
                keyManager.showSuccess('All keys cleared');
            }
        };
    </script>
</body>
</html> 
</html> 